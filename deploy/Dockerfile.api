# Mercur API (backend do AutoBaze Marketplace)
# Build do monorepo template (packages/api + dashboards admin/vendor bundlados)
FROM node:24-alpine AS build
WORKDIR /app
COPY backend/package.json backend/package-lock.json* ./
COPY backend/packages ./packages
COPY backend/apps ./apps
COPY backend/turbo.json backend/tsconfig*.json ./
RUN npm install --legacy-peer-deps && npm install ajv@^8.17.1 --legacy-peer-deps
# Build a partir da RAIZ: o turbo builda apps/admin e apps/vendor antes do
# packages/api. Buildar so' o api faz o bundle-dashboards nao achar
# apps/*/dist/index.html e a imagem sair SEM os paineis /dashboard e /seller,
# com o unico sintoma sendo 404 nessas rotas depois do deploy.
RUN npm run build

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app
WORKDIR /app/packages/api
EXPOSE 9000
# db:migrate roda no entrypoint pra migrations novas aplicarem no deploy
CMD ["sh", "-c", "npx medusa db:migrate && npm run start"]
