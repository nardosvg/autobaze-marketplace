# Mercur (AutoBaze Marketplace) — producao.
# Copiar pra /opt/mercur/.env na VPS e preencher. NAO commitar preenchido.

MERCUR_DB_PASSWORD=trocar-por-senha-forte

# CORS: so os dois dominios publicos do marketplace. O app NAO precisa entrar
# aqui — ele fala com a API por dentro da rede Docker (server-side), e CORS
# so vale pra browser.
STORE_CORS=https://marketplace.autobaze.com.br
ADMIN_CORS=https://mercur.autobaze.com.br
VENDOR_CORS=https://mercur.autobaze.com.br
AUTH_CORS=https://marketplace.autobaze.com.br,https://mercur.autobaze.com.br

JWT_SECRET=trocar-por-secret-forte
COOKIE_SECRET=trocar-por-secret-forte

MERCUR_VENDOR_URL=https://mercur.autobaze.com.br/seller
STOREFRONT_REVALIDATE_URL=http://mercur-storefront:3000
STOREFRONT_REVALIDATE_SECRET=trocar-por-secret-forte

# Webhook de pedido: o secret precisa ser IDENTICO ao MERCUR_WEBHOOK_SECRET
# do app (em /opt/operify-app/app.env). A URL ja vem do compose (nome do
# container), nao repetir aqui.
AUTOBAZE_WEBHOOK_SECRET=trocar-mesmo-secret-do-app

# URL publica dos uploads servidos pelo Mercur (o provider local grava esse
# host dentro de cada URL de arquivo; com localhost as imagens quebram).
FILE_BACKEND_URL=https://mercur.autobaze.com.br/static

# Storefront (inlinadas no bundle em tempo de build)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_trocar
NEXT_PUBLIC_BASE_URL=https://marketplace.autobaze.com.br

# Stripe Connect (payout provider) — preencher quando ativar repasses.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
